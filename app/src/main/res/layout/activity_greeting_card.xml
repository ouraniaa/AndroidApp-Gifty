<?xml version="1.0" encoding="utf-8"?>

<!-- Main root layout for the Greeting Card Generator screen -->
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/greetingRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#131316"
    tools:context=".ui.GreetingCardActivity">

    <!-- Top bar with back navigation and title -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/greetingTopBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingTop="16dp"
        android:paddingBottom="8dp"
        app:layout_constraintTop_toTopOf="parent">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="Go back"
            android:src="@drawable/baseline_arrow_back_ios_24"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="#8B5CF6" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-black"
                android:text="Greeting Card"
                android:textColor="#FFFFFF"
                android:textSize="22sp" />

            <!-- Subtitle is set in code: AI mode or explicit sample-template mode -->
            <TextView
                android:id="@+id/tvGreetingSubtitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Written with Gemini AI"
                android:textColor="#A0A0AB"
                android:textSize="14sp" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>

    <!-- Scrollable form and result -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/greetingTopBar"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="24dp"
            android:paddingTop="12dp"
            android:paddingBottom="40dp">

            <!-- Occasion dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilOccasion"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Occasion"
                android:textColorHint="#94A3B8"
                app:hintTextColor="#8B5CF6"
                app:boxStrokeColor="@drawable/input_box_stroke_color"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">

                <AutoCompleteTextView
                    android:id="@+id/spOccasion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Relationship dropdown -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilCardRelationship"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox.ExposedDropdownMenu"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Relationship"
                android:textColorHint="#94A3B8"
                app:hintTextColor="#8B5CF6"
                app:boxStrokeColor="@drawable/input_box_stroke_color"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">

                <AutoCompleteTextView
                    android:id="@+id/spCardRelationship"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="none"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Optional recipient name -->
            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/tilRecipientName"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:hint="Recipient name (optional)"
                android:textColorHint="#94A3B8"
                app:hintTextColor="#8B5CF6"
                app:counterEnabled="true"
                app:counterMaxLength="40"
                app:boxStrokeColor="@drawable/input_box_stroke_color"
                app:boxStrokeWidth="1.5dp"
                app:boxStrokeWidthFocused="2.5dp"
                app:boxCornerRadiusTopStart="16dp"
                app:boxCornerRadiusTopEnd="16dp"
                app:boxCornerRadiusBottomStart="16dp"
                app:boxCornerRadiusBottomEnd="16dp">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/etRecipientName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPersonName|textCapWords"
                    android:maxLength="40"
                    android:maxLines="1"
                    android:textColor="#FFFFFF" />
            </com.google.android.material.textfield.TextInputLayout>

            <!-- Tone selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Tone"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgTone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp"
                app:chipSpacingVertical="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipToneWarm"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Warm"
                    android:textColor="#FFFFFF"
                    android:checkable="true"
                    android:checked="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeColor="@drawable/chip_stroke_color"
                    app:chipStrokeWidth="2dp"
                    app:chipBackgroundColor="@drawable/chip_bg_color" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipToneFunny"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Funny"
                    android:textColor="#FFFFFF"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeColor="@drawable/chip_stroke_color"
                    app:chipStrokeWidth="2dp"
                    app:chipBackgroundColor="@drawable/chip_bg_color" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipToneFormal"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Formal"
                    android:textColor="#FFFFFF"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeColor="@drawable/chip_stroke_color"
                    app:chipStrokeWidth="2dp"
                    app:chipBackgroundColor="@drawable/chip_bg_color" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipToneRomantic"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Romantic"
                    android:textColor="#FFFFFF"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeColor="@drawable/chip_stroke_color"
                    app:chipStrokeWidth="2dp"
                    app:chipBackgroundColor="@drawable/chip_bg_color" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Language selection -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:text="Language"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black" />

            <com.google.android.material.chip.ChipGroup
                android:id="@+id/cgLanguage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                app:singleSelection="true"
                app:selectionRequired="true"
                app:chipSpacingHorizontal="8dp">

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLangEnglish"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="English"
                    android:textColor="#FFFFFF"
                    android:checkable="true"
                    android:checked="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeColor="@drawable/chip_stroke_color"
                    app:chipStrokeWidth="2dp"
                    app:chipBackgroundColor="@drawable/chip_bg_color" />

                <com.google.android.material.chip.Chip
                    android:id="@+id/chipLangGreek"
                    style="@style/Widget.MaterialComponents.Chip.Filter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Ελληνικά"
                    android:textColor="#FFFFFF"
                    android:checkable="true"
                    app:checkedIconVisible="false"
                    app:chipStrokeColor="@drawable/chip_stroke_color"
                    app:chipStrokeWidth="2dp"
                    app:chipBackgroundColor="@drawable/chip_bg_color" />
            </com.google.android.material.chip.ChipGroup>

            <!-- Generate button -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnGenerateCard"
                android:layout_width="match_parent"
                android:layout_height="60dp"
                android:layout_marginTop="32dp"
                android:text="Generate Message"
                android:textAllCaps="false"
                android:textSize="18sp"
                android:fontFamily="sans-serif-black"
                app:cornerRadius="20dp"
                android:backgroundTint="#8B5CF6" />

            <!-- Shown while a request is in progress -->
            <com.google.android.material.progressindicator.LinearProgressIndicator
                android:id="@+id/progressGreeting"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:indeterminate="true"
                android:visibility="gone"
                app:indicatorColor="#8B5CF6"
                app:trackColor="#1E1E24"
                app:trackCornerRadius="4dp" />

            <!-- Inline error message for failed requests -->
            <TextView
                android:id="@+id/tvGreetingError"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:textColor="#F87171"
                android:textSize="14sp"
                android:visibility="gone"
                tools:text="Couldn't reach the card writer. Check your internet connection and try again."
                tools:visibility="visible" />

            <!-- Result card, hidden until a message is generated -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/cardResult"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:visibility="gone"
                app:cardCornerRadius="24dp"
                app:cardElevation="0dp"
                app:strokeWidth="1dp"
                app:strokeColor="#251E35"
                app:cardBackgroundColor="#1E1E24"
                tools:visibility="visible">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="20dp">

                    <!-- Source label set in code: "Written by Gemini AI" or "Sample template · not AI-generated" -->
                    <TextView
                        android:id="@+id/tvResultBadge"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="#3A2A10"
                        android:paddingHorizontal="10dp"
                        android:paddingVertical="4dp"
                        tools:text="WRITTEN BY GEMINI AI"
                        android:textColor="#FBBF24"
                        android:textSize="11sp"
                        android:fontFamily="sans-serif-black"
                        android:letterSpacing="0.05" />

                    <TextView
                        android:id="@+id/tvCardMessage"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:lineSpacingExtra="4dp"
                        android:textColor="#E2E8F0"
                        android:textIsSelectable="true"
                        android:textSize="16sp"
                        tools:text="Dear friend,\n\nHappy birthday! Wishing you a day full of joy.\n\nWith love," />

                    <TextView
                        android:id="@+id/tvResultNote"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        tools:text="Created by Google's Gemini AI. Please read it before sending."
                        android:textColor="#64748B"
                        android:textSize="12sp" />

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/btnCopyMessage"
                        style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:layout_marginTop="16dp"
                        android:text="Copy Message"
                        android:textAllCaps="false"
                        android:textColor="#A78BFA"
                        android:textSize="15sp"
                        android:fontFamily="sans-serif-medium"
                        app:cornerRadius="16dp"
                        app:strokeColor="#8B5CF6" />
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>
